// -*- mode: jsonc -*-
{
    "position": "right",
    "height": 400,

    // next three make it float, don't use mode: overlay as that breaks interactivity
    "layer": "top",
    "exclusive": false,
    "passthrough": false,

    "output": "eDP-1",

    "reload_style_on_change": true,

    "modules-left": [
    ],
    "modules-center": [
        "custom/power",
        "network",
        "wireplumber",
        "backlight",
        "battery",
        "tray",
        "custom/browser",
        "custom/files",
        "clock"
    ],
    "modules-right": [
    ],

    "taskbar": {
        "format": "{icon}"
    },
    "tray": {
        "icon-size": 12,
        "rotate": 270,
        "spacing": 0,
        "icons": {
            "blueman": "bluetooth-symbolic",
            "udiskie": "media-removable-symbolic"
        }
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        "rotate": 270
    },
    "backlight": {
        "format": "{icon}",
        "tooltip-format": "{percent:3}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "rotate": 270
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-full": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity:3}%",
        "rotate": 270
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "{ipaddr}/{cidr}",
        "tooltip-format": "{essid} {ifname} via {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "󰖪",
        "rotate": 270,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/wifi_menu.xml", // Menu file in resources folder
        "menu-actions": {
            "scan": "iwctl station wlan0 scan",
            "connect": "iwctl station wlan0 connect \"Network Name Here\""
        }
    },
    "wireplumber": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["", "", ""],
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{volume:3}%", // TODO: change to MUTE
        "rotate": 270,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/audio_menu.xml", // Menu file in resources folder
        "menu-actions": {
            "hdmi": "pactl set-card-profile \"$(pactl list short cards | cut -f2)\" output:hdmi-stereo+input:analog-stereo",
            "builtin": "pactl set-card-profile \"$(pactl list short cards | cut -f2)\" output:analog-stereo+input:analog-stereo",
            "mute": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
        }
    },
    "custom/browser": {
        "format": "󰈹",
        "on-click": "flatpak run app.zen_browser.zen",
        "tooltip-format": "Browser",
        "rotate": 270
    },
    "custom/files": {
        "format": "",
        "on-click": "nautilus",
        "tooltip-format": "Files",
        "rotate": 270
    },
    "custom/power": {
        "format" : "󰐥",
        "rotate": 270,
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
        "menu-actions": {
            "shutdown": "hyprshutdown --post-cmd 'systemctl poweroff'",
            "reboot": "hyprshutdown --post-cmd 'systemctl reboot'",
            "quit": "hyprshutdown"
        }
    }
}
